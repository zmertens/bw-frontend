#version 330 core

// Level-transition effect over the composited frame. intensity fades 1 -> 0.
uniform sampler2D scene;
uniform float intensity;
uniform float phase;
uniform vec2 texel;

in vec2 fragment_uv;
out vec4 fragColor;

void main() {
    // Original 3x3 tent kernel (weights sum to 16); only the radius changes over time.
    float radius = intensity * 6.0;
    vec2 offx = vec2(texel.x * radius, 0.0);
    vec2 offy = vec2(0.0, texel.y * radius);
    vec2 uv = fragment_uv;
    vec3 pixel = texture(scene, uv).rgb * 4.0 +
                 (texture(scene, uv - offx).rgb + texture(scene, uv + offx).rgb +
                  texture(scene, uv - offy).rgb + texture(scene, uv + offy).rgb) * 2.0 +
                 texture(scene, uv - offx - offy).rgb + texture(scene, uv - offx + offy).rgb +
                 texture(scene, uv + offx - offy).rgb + texture(scene, uv + offx + offy).rgb;
    fragColor = vec4(pixel / 16.0, 1.0);
}
#version 330 core

// Level-transition effect over the composited frame. intensity fades 1 -> 0.
uniform sampler2D scene;
uniform float intensity;
uniform float phase;
uniform vec2 texel;

in vec2 fragment_uv;
out vec4 fragColor;

void main() {
    // Same quantization as the original pixelate.frag, with the threshold driven by intensity.
    float factor = 1.0 / (intensity * 0.04 + 0.001);
    vec2 pos = (floor(fragment_uv * factor) + 0.5) / factor;
    fragColor = vec4(texture(scene, clamp(pos, 0.0, 1.0)).rgb, 1.0);
}
#version 330 core

// Level-transition effect over the composited frame. intensity fades 1 -> 0.
uniform sampler2D scene;
uniform float intensity;
uniform float phase;
uniform vec2 texel;

in vec2 fragment_uv;
out vec4 fragColor;

void main() {
    // The original wave.vert displaced sprite vertices; a full-screen quad has only four,
    // so the same sine/cosine field displaces the texture coordinates per fragment.
    vec2 amplitude = vec2(0.03, 0.03) * intensity;
    vec2 p = fragment_uv * 40.0;
    vec2 uv = fragment_uv;
    uv.x += cos(p.y + phase * 3.8) * amplitude.x + sin(p.y + phase * 6.3) * amplitude.x * 0.3;
    uv.y += sin(p.x + phase * 2.4) * amplitude.y + cos(p.x + phase * 5.2) * amplitude.y * 0.3;
    fragColor = vec4(texture(scene, clamp(uv, 0.0, 1.0)).rgb, 1.0);
}
