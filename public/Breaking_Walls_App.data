#version 330 core

uniform sampler2D sampler;
uniform float timer;
uniform float daylight;
uniform bool is_ortho;
uniform float bloom_emission;
uniform float light_attenuation;
uniform bool mirror_mask;

in vec3 world_position;
in vec3 surface_normal;
in vec2 fragment_uv;
in float fragment_ao;
in float fragment_light;
in float fog_factor;
in float fog_height;
in float diffuse;

layout (location = 0) out vec4 fragColor;
layout (location = 1) out vec4 brightColor;


// Balls cast soft shadows and bounce light by material: 0 diffuse, 1 metal, 2 dielectric.
uniform int ball_count;
uniform vec4 spheres[16];
uniform vec4 surfaces[16];

float ball_blocks(vec3 origin, vec3 direction, vec4 sphere) {
    vec3 offset = origin - sphere.xyz;
    float half_b = dot(offset, direction);
    float discriminant = half_b * half_b - dot(offset, offset) + sphere.w * sphere.w;
    return (discriminant >= 0.0 && half_b < 0.0) ? 1.0 : 0.0;
}

void ball_shading(vec3 point, vec3 normal, out vec3 shade, out vec3 glow) {
    shade = vec3(1.0);
    glow = vec3(0.0);
    for (int i = 0; i < 16; ++i) {
        if (i >= ball_count) break;
        vec4 sphere = spheres[i];
        // Shadow offset grows with the drop from the ball (light slope ~0.65 incl. softening) and
        // glow reaches 2.2 cells, so distant balls are skipped before any ray tests.
        vec2 flat_offset = sphere.xz - point.xz;
        float reach_limit = max(2.2, (sphere.y - point.y) * 0.65 + sphere.w + 0.1);
        if (dot(flat_offset, flat_offset) > reach_limit * reach_limit) continue;
        vec3 tint = surfaces[i].rgb;
        float kind = surfaces[i].a;
        vec3 origin = point + normal * 0.01;
        float blocked = 0.0;
        for (int s = 0; s < 4; ++s) {
            vec2 jitter = vec2((s & 1) == 0 ? -0.12 : 0.12, (s & 2) == 0 ? -0.12 : 0.12);
            blocked += ball_blocks(origin, normalize(vec3(-0.5 + jitter.x, 1.0, -0.35 + jitter.y)), sphere);
        }
        blocked *= 0.25;
        vec3 umbra = kind < 0.5 ? vec3(0.38) : (kind < 1.5 ? vec3(0.22) : mix(vec3(0.62), tint, 0.45));
        shade *= mix(vec3(1.0), umbra, blocked);
        vec3 to_ball = sphere.xyz - point;
        float distance_to_ball = length(to_ball);
        float reach = clamp(1.0 - distance_to_ball / 2.2, 0.0, 1.0);
        float facing = max(dot(normal, to_ball / max(distance_to_ball, 0.001)), 0.0);
        float bounce = kind < 0.5 ? 0.22 : (kind < 1.5 ? 0.12 : 0.34);
        glow += tint * reach * reach * facing * bounce;
    }
}

const float pi = 3.14159265;

void main() {
    vec4 texColor = texture(sampler, fragment_uv);
    vec3 color = texColor.rgb;

    // Discard transparent pixels or magenta color key FIRST (before any other checks)
    // Relaxed thresholds to handle texture filtering/mipmapping artifacts
    bool is_magenta = (color.r > 0.7 && color.g < 0.3 && color.b > 0.7 &&
                      abs(color.r - color.b) < 0.3 && color.g < min(color.r, color.b) * 0.5);
    if (texColor.a < 0.5 || is_magenta) {
        discard;
    }
    // Stencil mask pass: only the upward-facing tops of the top layer receive reflections.
    if (mirror_mask && (normalize(surface_normal).y < 0.9 || world_position.y < 7.0)) {
        discard;
    }

    // Detect maze texture: fragment_light == 1.0 AND fragment_ao == 1.0 (from uv.z=0.0)
    // This must come after transparency check but before cloud check
    // Render it without any lighting, AO, or fog effects
    if (fragment_light >= 0.99 && fragment_ao >= 0.99) {
        // Maze texture detected - render at full brightness without lighting/fog
        fragColor = vec4(color, 1.0);
        brightColor = vec4(0.0, 0.0, 0.0, 1.0);
        return;
    }


    bool cloud = color == vec3(1.0, 1.0, 1.0);
    if (cloud && is_ortho) {
        discard;
    }
    float df = cloud ? diffuse * 1.2 : diffuse;
    float ao = cloud ? fragment_ao * 1.2 : fragment_ao;

    float local_light = fragment_light * (1.0 - clamp(light_attenuation, 0.0, 1.0));
    ao += local_light;
    df += local_light;
    float value = daylight + local_light;
    vec3 light_color = vec3(value * 0.3 + 0.2);
    vec3 ambient = vec3(value * 0.3 + 0.2);
    vec3 light = ambient + light_color * df;
    color *= light * ao;
    vec3 ball_shade, ball_glow;
    ball_shading(world_position, normalize(surface_normal), ball_shade, ball_glow);
    color = color * ball_shade + ball_glow;
    // Apply fog with sky blue color that matches the background
    vec3 fog_color = vec3(0.53, 0.81, 0.92) * (daylight * 0.4 + 0.6);
    color = mix(color, fog_color, fog_factor);
    fragColor = vec4(color, 1.0);

    float brightness = dot(fragColor.rgb, vec3(0.2126, 0.7152, 0.0722));
    if (bloom_emission > 0.0) {
        brightColor = vec4(color * fragment_light * bloom_emission, 1.0);
    } else if (brightness > 1.0) {
        brightColor = vec4(fragColor.rgb, 1.0);
    } else {
        brightColor = vec4(0.0, 0.0, 0.0, 1.0);
    }
}
#version 330 core

uniform mat4 matrix;
uniform vec3 camera;
uniform float fog_distance;
uniform bool is_ortho;
uniform float stack_taper;
uniform float stack_center;
uniform float fall_progress;

layout(location = 0) in vec4 position;
layout(location = 1) in vec3 normal;
layout(location = 2) in vec4 uv;

out vec2 fragment_uv;
out float fragment_ao;
out float fragment_light;
out float fog_factor;
out float fog_height;
out float diffuse;
out vec3 world_position;
out vec3 surface_normal;

const float pi = 3.14159265;
const vec3 light_direction = normalize(vec3(-1.0, 1.0, -1.0));

void main() {
    vec4 viewed = position;
    if (uv.w > 1.5 && uv.w < 2.5 && stack_taper > 0.0)
        viewed.y -= 2.0 * fall_progress;
    float shrink = 1.0 - stack_taper * max(0.0, (7.0 - viewed.y) * 0.5);
    viewed.xz = (viewed.xz - stack_center) * shrink + stack_center;
    gl_Position = matrix * viewed;
    world_position = position.xyz;
    surface_normal = normal;
    fragment_uv = uv.xy;
    fragment_ao = 0.3 + (1.0 - uv.z) * 0.7;
    fragment_light = uv.w;
    diffuse = max(0.0, dot(normal, light_direction));
    if (is_ortho) {
        fog_factor = 0.0;
        fog_height = 0.0;
    }
    else {
        float camera_distance = distance(camera, vec3(position));
        fog_factor = pow(clamp(camera_distance / fog_distance, 0.0, 1.0), 4.0);
        float dy = position.y - camera.y;
        float dx = distance(position.xz, camera.xz);
        fog_height = (atan(dy, dx) + pi / 2) / pi;
    }
}
#version 330 core

uniform sampler2D image;
uniform bool horizontal;

in vec2 fragment_uv;
out vec4 fragColor;

// 9-tap Gaussian weights (normalised).
// Kernel: [0.0625, 0.25, 0.375, 0.25, 0.0625] Ã— [same] spread over 5 taps each side.
const float weight[5] = float[](0.227027, 0.194595, 0.121622, 0.054054, 0.016216);

void main() {
    vec2 tex_offset = 1.0 / textureSize(image, 0);
    vec3 result = texture(image, fragment_uv).rgb * weight[0];

    if (horizontal) {
        for (int i = 1; i < 5; ++i) {
            result += texture(image, fragment_uv + vec2(tex_offset.x * float(i), 0.0)).rgb * weight[i];
            result += texture(image, fragment_uv - vec2(tex_offset.x * float(i), 0.0)).rgb * weight[i];
        }
    } else {
        for (int i = 1; i < 5; ++i) {
            result += texture(image, fragment_uv + vec2(0.0, tex_offset.y * float(i))).rgb * weight[i];
            result += texture(image, fragment_uv - vec2(0.0, tex_offset.y * float(i))).rgb * weight[i];
        }
    }

    fragColor = vec4(result, 1.0);
}
#version 330 core

uniform sampler2D scene;
uniform sampler2D bloom_blur;
uniform float bloom_strength;

in vec2 fragment_uv;
out vec4 fragColor;

void main() {
    vec3 scene_color = texture(scene, fragment_uv).rgb;
    vec3 bloom_color = texture(bloom_blur, fragment_uv).rgb;

    // Additive blend: bright glowing regions add on top of the scene.
    vec3 result = scene_color + bloom_color * bloom_strength;

    fragColor = vec4(result, 1.0);
}
#version 330 core

layout(location = 0) in vec2 position;
layout(location = 1) in vec2 uv;

out vec2 fragment_uv;

void main() {
    fragment_uv = uv;
    gl_Position = vec4(position, 0.0, 1.0);
}
#version 330 core

uniform float seconds;
uniform float level;
uniform float lights;
in vec2 fragment_uv;
layout(location = 0) out vec4 fragColor;
layout(location = 1) out vec4 brightColor;

void main() {
    vec2 screen = fragment_uv * 2.0 - 1.0;
    vec3 radiance = vec3(0.012, 0.018, 0.055);
    for (int plane = 0; plane < 9; ++plane) {
        float depth = float(plane) + 1.0;
        vec2 drift = vec2(sin(seconds * 0.12), cos(seconds * 0.09)) * 0.12;
        vec2 p = screen * (2.0 + depth * 0.65) + drift * depth;
        p.y += seconds * 0.08 + level * 0.11;
        vec2 edge = abs(fract(p) - 0.5);
        float line = 1.0 - smoothstep(0.008, 0.035, min(edge.x, edge.y));
        float ripple = 0.55 + 0.45 * sin(depth * 1.7 + seconds * 0.4 + length(screen) * 4.0);
        vec3 tint = mix(vec3(0.04, 0.35, 0.9), vec3(0.65, 0.06, 0.5), depth / 10.0);
        radiance += tint * line * ripple * (0.085 / depth);
    }
    radiance *= 1.0 + lights * 0.035;
    radiance *= 1.0 - 0.25 * smoothstep(0.3, 1.4, length(screen));
    fragColor = vec4(radiance, 1.0);
    brightColor = vec4(0.0, 0.0, 0.0, 1.0);
}
#version 300 es
precision highp float;

uniform sampler2D sampler;
uniform float timer;
uniform float daylight;
uniform bool is_ortho;
uniform float bloom_emission;
uniform float light_attenuation;
uniform bool mirror_mask;

in vec3 world_position;
in vec3 surface_normal;
in vec2 fragment_uv;
in float fragment_ao;
in float fragment_light;
in float fog_factor;
in float fog_height;
in float diffuse;

layout (location = 0) out vec4 fragColor;
layout (location = 1) out vec4 brightColor;


// Balls cast soft shadows and bounce light by material: 0 diffuse, 1 metal, 2 dielectric.
uniform int ball_count;
uniform vec4 spheres[16];
uniform vec4 surfaces[16];

float ball_blocks(vec3 origin, vec3 direction, vec4 sphere) {
    vec3 offset = origin - sphere.xyz;
    float half_b = dot(offset, direction);
    float discriminant = half_b * half_b - dot(offset, offset) + sphere.w * sphere.w;
    return (discriminant >= 0.0 && half_b < 0.0) ? 1.0 : 0.0;
}

void ball_shading(vec3 point, vec3 normal, out vec3 shade, out vec3 glow) {
    shade = vec3(1.0);
    glow = vec3(0.0);
    for (int i = 0; i < 16; ++i) {
        if (i >= ball_count) break;
        vec4 sphere = spheres[i];
        // Shadow offset grows with the drop from the ball (light slope ~0.65 incl. softening) and
        // glow reaches 2.2 cells, so distant balls are skipped before any ray tests.
        vec2 flat_offset = sphere.xz - point.xz;
        float reach_limit = max(2.2, (sphere.y - point.y) * 0.65 + sphere.w + 0.1);
        if (dot(flat_offset, flat_offset) > reach_limit * reach_limit) continue;
        vec3 tint = surfaces[i].rgb;
        float kind = surfaces[i].a;
        vec3 origin = point + normal * 0.01;
        float blocked = 0.0;
        for (int s = 0; s < 4; ++s) {
            vec2 jitter = vec2((s & 1) == 0 ? -0.12 : 0.12, (s & 2) == 0 ? -0.12 : 0.12);
            blocked += ball_blocks(origin, normalize(vec3(-0.5 + jitter.x, 1.0, -0.35 + jitter.y)), sphere);
        }
        blocked *= 0.25;
        vec3 umbra = kind < 0.5 ? vec3(0.38) : (kind < 1.5 ? vec3(0.22) : mix(vec3(0.62), tint, 0.45));
        shade *= mix(vec3(1.0), umbra, blocked);
        vec3 to_ball = sphere.xyz - point;
        float distance_to_ball = length(to_ball);
        float reach = clamp(1.0 - distance_to_ball / 2.2, 0.0, 1.0);
        float facing = max(dot(normal, to_ball / max(distance_to_ball, 0.001)), 0.0);
        float bounce = kind < 0.5 ? 0.22 : (kind < 1.5 ? 0.12 : 0.34);
        glow += tint * reach * reach * facing * bounce;
    }
}

const float pi = 3.14159265;

void main() {
    vec3 color = texture(sampler, fragment_uv).rgb;
    if (color == vec3(1.0, 0.0, 1.0)) {
        discard;
    }
    // Stencil mask pass: only the upward-facing tops of the top layer receive reflections.
    if (mirror_mask && (normalize(surface_normal).y < 0.9 || world_position.y < 7.0)) {
        discard;
    }
    bool cloud = color == vec3(1.0, 1.0, 1.0);
    if (cloud && is_ortho) {
        discard;
    }
    float df = cloud ? diffuse * 1.2 : diffuse;
    float ao = cloud ? fragment_ao * 1.2 : fragment_ao;

    float local_light = fragment_light * (1.0 - clamp(light_attenuation, 0.0, 1.0));
    ao += local_light;
    df += local_light;
    float value = daylight + local_light;
    vec3 light_color = vec3(value * 0.3 + 0.2);
    vec3 ambient = vec3(value * 0.3 + 0.2);
    vec3 light = ambient + light_color * df;
    color *= light * ao;
    vec3 ball_shade, ball_glow;
    ball_shading(world_position, normalize(surface_normal), ball_shade, ball_glow);
    color = color * ball_shade + ball_glow;
    vec3 fog_mix = vec3(timer, fog_height, 0.0);
    color = mix(color, vec3(0.0), fog_mix.y * fog_factor);
    fragColor = vec4(color, 1.0);
    
    float brightness = dot(fragColor.rgb, vec3(0.2126, 0.7152, 0.0722));
    if (bloom_emission > 0.0) {
        brightColor = vec4(color * fragment_light * bloom_emission, 1.0);
    } else if (brightness > 1.0) {
        brightColor = vec4(fragColor.rgb, 1.0);
    } else {
        brightColor = vec4(0.0, 0.0, 0.0, 1.0);
    }
}
#version 300 es
precision highp float;

uniform mat4 matrix;
uniform vec3 camera;
uniform float fog_distance;
uniform bool is_ortho;
uniform float stack_taper;
uniform float stack_center;
uniform float fall_progress;

layout(location = 0) in vec4 position;
layout(location = 1) in vec3 normal;
layout(location = 2) in vec4 uv;

out vec2 fragment_uv;
out float fragment_ao;
out float fragment_light;
out float fog_factor;
out float fog_height;
out float diffuse;
out vec3 world_position;
out vec3 surface_normal;

const float pi = 3.14159265;
const vec3 light_direction = normalize(vec3(-1.0, 1.0, -1.0));

void main() {
    vec4 viewed = position;
    if (uv.w > 1.5 && uv.w < 2.5 && stack_taper > 0.0)
        viewed.y -= 2.0 * fall_progress;
    float shrink = 1.0 - stack_taper * max(0.0, (7.0 - viewed.y) * 0.5);
    viewed.xz = (viewed.xz - stack_center) * shrink + stack_center;
    gl_Position = matrix * viewed;
    world_position = position.xyz;
    surface_normal = normal;
    fragment_uv = uv.xy;
    fragment_ao = 0.3 + (1.0 - uv.z) * 0.7;
    fragment_light = uv.w;
    diffuse = max(0.0, dot(normal, light_direction));
    if (is_ortho) {
        fog_factor = 0.0;
        fog_height = 0.0;
    }
    else {
        float camera_distance = distance(camera, vec3(position));
        fog_factor = pow(clamp(camera_distance / fog_distance, 0.0, 1.0), 4.0);
        float dy = position.y - camera.y;
        float dx = distance(position.xz, camera.xz);
        fog_height = (atan(dy, dx) + pi / 2.0) / pi;
    }
}
#version 300 es
precision mediump float;

uniform sampler2D image;
uniform bool horizontal;

in vec2 fragment_uv;
out vec4 fragColor;

const float weight[5] = float[](0.227027, 0.194595, 0.121622, 0.054054, 0.016216);

void main() {
    vec2 tex_offset = 1.0 / vec2(textureSize(image, 0));
    vec3 result = texture(image, fragment_uv).rgb * weight[0];

    if (horizontal) {
        for (int i = 1; i < 5; ++i) {
            result += texture(image, fragment_uv + vec2(tex_offset.x * float(i), 0.0)).rgb * weight[i];
            result += texture(image, fragment_uv - vec2(tex_offset.x * float(i), 0.0)).rgb * weight[i];
        }
    } else {
        for (int i = 1; i < 5; ++i) {
            result += texture(image, fragment_uv + vec2(0.0, tex_offset.y * float(i))).rgb * weight[i];
            result += texture(image, fragment_uv - vec2(0.0, tex_offset.y * float(i))).rgb * weight[i];
        }
    }

    fragColor = vec4(result, 1.0);
}
#version 300 es
precision mediump float;

uniform sampler2D scene;
uniform sampler2D bloom_blur;
uniform float bloom_strength;

in vec2 fragment_uv;
out vec4 fragColor;

void main() {
    vec3 scene_color = texture(scene, fragment_uv).rgb;
    vec3 bloom_color = texture(bloom_blur, fragment_uv).rgb;
    vec3 result = scene_color + bloom_color * bloom_strength;
    fragColor = vec4(result, 1.0);
}
