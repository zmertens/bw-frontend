}
#version 300 es
precision highp float;

uniform float seconds;
uniform float level;
uniform float lights;
in vec2 fragment_uv;
layout(location = 0) out vec4 fragColor;
layout(location = 1) out vec4 brightColor;

void main() {
    vec2 screen = fragment_uv * 2.0 - 1.0;
    vec3 radiance = vec3(0.012, 0.018, 0.055);
    for (int plane = 0; plane < 9; ++plane) {
        float depth = float(plane) + 1.0;
        vec2 drift = vec2(sin(seconds * 0.12), cos(seconds * 0.09)) * 0.12;
        vec2 p = screen * (2.0 + depth * 0.65) + drift * depth;
        p.y += seconds * 0.08 + level * 0.11;
        vec2 edge = abs(fract(p) - 0.5);
        float line = 1.0 - smoothstep(0.008, 0.035, min(edge.x, edge.y));
        float ripple = 0.55 + 0.45 * sin(depth * 1.7 + seconds * 0.4 + length(screen) * 4.0);
        vec3 tint = mix(vec3(0.04, 0.35, 0.9), vec3(0.65, 0.06, 0.5), depth / 10.0);
        radiance += tint * line * ripple * (0.085 / depth);
    }
    radiance *= 1.0 + lights * 0.035;
    radiance *= 1.0 - 0.25 * smoothstep(0.3, 1.4, length(screen));
    fragColor = vec4(radiance, 1.0);
    brightColor = vec4(0.0, 0.0, 0.0, 1.0);
}
#version 300 es
precision highp float;
precision highp int;
precision lowp samplerCube;

uniform mat4 matrix;
uniform int ball_count;
uniform vec4 spheres[16];
uniform vec4 surfaces[16];
uniform samplerCube environment_map;
uniform bool environment_enabled;
uniform bool mirrored;
uniform float seconds;
flat in int sphere_index;
in vec3 ray_origin;
in vec3 ray_direction;
layout(location = 0) out vec4 fragColor;
layout(location = 1) out vec4 brightColor;

float hit_sphere(vec3 origin, vec3 direction, vec4 sphere) {
    vec3 offset = origin - sphere.xyz;
    float half_b = dot(offset, direction);
    float discriminant = half_b * half_b - dot(offset, offset) + sphere.w * sphere.w;
    if (discriminant < 0.0) return -1.0;
    float root = sqrt(discriminant);
    float distance = -half_b - root;
    return distance > 0.001 ? distance : (-half_b + root > 0.001 ? -half_b + root : -1.0);
}

vec3 environment(vec3 direction) {
    if (environment_enabled)
        return texture(environment_map, mirrored ? direction * vec3(1.0, -1.0, 1.0) : direction).rgb * 0.85 + vec3(0.06);
    float sky = clamp((mirrored ? -direction.y : direction.y) * 0.5 + 0.5, 0.0, 1.0);
    return mix(vec3(0.04, 0.07, 0.16), vec3(0.55, 0.65, 0.8), sky);
}

vec3 lighting(vec3 normal, vec3 view, vec3 color, float visibility) {
    vec3 light = normalize(vec3(-0.5, mirrored ? -1.0 : 1.0, -0.35));
    float diffuse = max(dot(normal, light), 0.0);
    float specular = pow(max(dot(normal, normalize(light + view)), 0.0), 48.0);
    return color * (0.18 + diffuse * visibility * 0.82) + vec3(specular * visibility * 0.45);
}

vec3 animated_surface(vec3 normal, vec4 sphere, vec4 surface) {
    const float pi = 3.141592653589793;
    float spin = seconds * (1.8 + fract(sphere.x * 11.13 + sphere.z * 7.19) * 2.7);
    vec2 uv = vec2(atan(normal.z, normal.x) / (2.0 * pi) + 0.5,
                  0.5 + asin(normal.y) / pi);
    uv = uv * vec2(2.5, 1.35);
    mat2 rotation = mat2(cos(spin), -sin(spin), sin(spin), cos(spin));
    uv = rotation * uv;

    float bands = 0.5 + 0.5 * sin((uv.x * 16.0 + uv.y * 8.0) + spin * 4.5);
    float flecks = 0.5 + 0.5 * sin((uv.x * 28.0 - uv.y * 19.0) + spin * 6.0);
    float grain = 0.5 + 0.5 * sin((uv.x + uv.y * 1.8) * 26.0 + spin * 5.0) *
                 cos((uv.x - uv.y) * 18.0 - spin * 2.5);
    float texture_mix = smoothstep(0.2, 1.0, bands * 0.45 + flecks * 0.35 + grain * 0.2);
    vec3 base = surface.rgb;
    vec3 lit = mix(base, vec3(1.0), 0.18 + 0.42 * texture_mix);
    vec3 accent = mix(base * 1.25, vec3(0.92, 0.96, 1.0), 0.6);
    vec3 textured = mix(lit, accent, 0.18 + 0.28 * sin((uv.x * 10.0 + spin * 2.0)));

    float material = clamp(surface.a, 0.0, 2.0);
    if (material < 0.5) {
        return mix(base, textured, 0.55);
    } else if (material < 1.5) {
        vec3 metal = mix(base * 0.72, texture_mix * vec3(0.85, 0.9, 1.0), 0.7);
        return mix(metal, textured, 0.8) + vec3(0.08, 0.1, 0.12) * texture_mix;
    }
    vec3 glass = mix(base, vec3(1.0), 0.25 + 0.35 * texture_mix);
    return mix(glass, vec3(0.9, 0.96, 1.0), 0.22 * smoothstep(0.7, 1.0, texture_mix));
}

// One secondary scene query; no recursion or full-screen primary sphere search.
vec3 secondary(vec3 origin, vec3 direction, int skip) {
    float closest = 1000.0;
    int found = -1;
    for (int i = 0; i < 16; ++i) {
        if (i >= ball_count) break;
        if (i == skip) continue;
        float distance = hit_sphere(origin, direction, spheres[i]);
        if (distance > 0.0 && distance < closest) {
            closest = distance;
            found = i;
        }
    }
    if (found < 0) return environment(direction);
    vec3 normal = normalize(origin + direction * closest - spheres[found].xyz);
    return lighting(normal, -direction, surfaces[found].rgb, 1.0);
}

float shadow(vec3 point, vec3 normal) {
    float visible = 0.0;
    for (int sample_index = 0; sample_index < 4; ++sample_index) {
        vec2 offset = vec2((sample_index & 1) == 0 ? -0.12 : 0.12,
                           (sample_index & 2) == 0 ? -0.12 : 0.12);
        vec3 light = normalize(vec3(-0.5 + offset.x, mirrored ? -1.0 : 1.0, -0.35 + offset.y));
        float blocked = 0.0;
        for (int i = 0; i < 16; ++i) {
            if (i >= ball_count) break;
            if (i == sphere_index) continue;
            if (hit_sphere(point + normal * 0.002, light, spheres[i]) > 0.0) {
                blocked = 1.0;
                break;
            }
        }
        visible += 1.0 - blocked;
    }
    return visible * 0.25;
}

void main() {
    vec3 direction = normalize(ray_direction);
    vec4 sphere = spheres[sphere_index];
    vec3 origin = ray_origin + direction * (dot(sphere.xyz - ray_origin, direction) - 2.0 * sphere.w);
    float distance = hit_sphere(origin, direction, sphere);
    if (distance < 0.0) discard;
    vec3 point = origin + distance * direction;
    vec3 normal = normalize(point - sphere.xyz);
    vec4 surface = surfaces[sphere_index];
    vec3 surface_color = animated_surface(normal, sphere, surface);
    vec3 radiance = lighting(normal, -direction, surface_color, shadow(point, normal));
    vec3 reflected = reflect(direction, normal);
    if (surface.a > 0.5 && surface.a < 1.5) {
        vec3 fresnel = surface_color + (vec3(1.0) - surface_color) *
                       pow(1.0 - max(dot(-direction, normal), 0.0), 5.0);
        radiance = radiance * 0.2 + fresnel * secondary(point + normal * 0.002, reflected, sphere_index);
    } else if (surface.a >= 1.5) {
        float fresnel = 0.04 + 0.96 * pow(1.0 - max(dot(-direction, normal), 0.0), 5.0);
        vec3 inside = refract(direction, normal, 1.0 / 1.5);
        float exit_distance = hit_sphere(point - normal * 0.002, inside, sphere);
        vec3 exit_point = point - normal * 0.002 + inside * max(exit_distance, 0.0);
        vec3 exit_normal = normalize(exit_point - sphere.xyz);
        vec3 transmitted = refract(inside, -exit_normal, 1.5);
        vec3 reflection = secondary(point + normal * 0.002, reflected, sphere_index);
        if (dot(transmitted, transmitted) < 0.001) {
            radiance = reflection;
        } else {
            vec3 transmission = secondary(exit_point + exit_normal * 0.002, normalize(transmitted), sphere_index);
            radiance = mix(transmission * mix(vec3(1.0), surface_color, 0.2), reflection, fresnel) +
                       radiance * 0.12;
        }
    }
    vec4 clip = matrix * vec4(point, 1.0);
    gl_FragDepth = clip.z / clip.w * 0.5 + 0.5;
    fragColor = vec4(radiance, 1.0);
    brightColor = vec4(max(radiance - vec3(0.85), vec3(0.0)), 1.0);
}
#version 300 es
precision highp float;
precision highp int;

uniform mat4 matrix;
uniform int ball_index;
uniform vec4 spheres[16];
flat out int sphere_index;
out vec3 ray_origin;
out vec3 ray_direction;

void main() {
    sphere_index = ball_index;
    vec4 sphere = spheres[ball_index];
    vec2 corner = vec2((gl_VertexID & 1) == 0 ? -1.0 : 1.0,
                       (gl_VertexID & 2) == 0 ? -1.0 : 1.0);
    vec4 center = matrix * vec4(sphere.xyz, 1.0);
    vec2 extent = sphere.w * vec2(length(vec3(matrix[0][0], matrix[1][0], matrix[2][0])),
                                 length(vec3(matrix[0][1], matrix[1][1], matrix[2][1])));
    vec2 clip = center.xy + corner * extent;
    mat4 unproject = inverse(matrix);
    vec4 near_point = unproject * vec4(clip, -1.0, 1.0);
    vec4 far_point = unproject * vec4(clip, 1.0, 1.0);
    ray_origin = near_point.xyz / near_point.w;
    ray_direction = far_point.xyz / far_point.w - ray_origin;
    gl_Position = vec4(clip, 0.0, 1.0);
}
#version 300 es
precision highp float;

uniform samplerCube environment_map;
uniform float rotation;
uniform float zoom;
uniform vec2 pan;
uniform vec2 viewport_scale;
// seconds, level, activated lights, board half-width in camera units
uniform vec4 animation;
in vec2 screen_position;
layout(location = 0) out vec4 fragColor;
layout(location = 1) out vec4 brightColor;

vec3 neon_field(vec2 world) {
    vec3 radiance = vec3(0.012, 0.018, 0.055);
    vec2 drift = vec2(sin(animation.x * 0.12), cos(animation.x * 0.09)) * 0.12;
    for (int plane = 0; plane < 9; ++plane) {
        float depth = float(plane) + 1.0;
        vec2 p = world * (2.0 + depth * 0.65) + drift * depth;
        p.y += animation.x * 0.08 + animation.y * 0.11;
        vec2 edge = abs(fract(p) - 0.5);
        float line_width = max(0.012, max(fwidth(p.x), fwidth(p.y)));
        float line = 1.0 - smoothstep(0.008, 0.008 + line_width, min(edge.x, edge.y));
        float ripple = 0.55 + 0.45 * sin(depth * 1.7 + animation.x * 0.4 + length(world) * 4.0);
        vec3 tint = mix(vec3(0.04, 0.35, 0.9), vec3(0.65, 0.06, 0.5), depth / 10.0);
        radiance += tint * line * ripple * (0.16 / depth);
    }
    return radiance * (1.0 + animation.z * 0.035);
}

void main() {
    vec2 local = vec2(screen_position.x, -screen_position.y) * viewport_scale / zoom;
    float c = cos(rotation), s = sin(rotation);
    vec2 world = vec2(c * local.x - s * local.y, s * local.x + c * local.y) + pan;
    // Rings spread outward from the heightmap edge; every lit light adds strength. They bend the
    // cubemap lookup (refraction) and brighten it (reflection), so the clouds ripple instead of fog.
    float board_distance = max(abs(world.x), abs(world.y)) / max(animation.w, 0.01);
    float edge = board_distance - 1.0;
    float travel = edge * 7.0 - animation.x * 1.4 - animation.y * 0.5;
    float envelope = smoothstep(-0.25, 0.1, edge) * exp(-max(edge, 0.0) * 0.9);
    float strength = envelope * (0.35 + 0.13 * animation.z);
    float wave = sin(travel);
    vec2 outward = normalize(world + vec2(1e-4));
    vec3 direction = normalize(vec3(world.x, -0.7, world.y) + vec3(outward.x, 0.0, outward.y) * wave * strength * 0.5);
    vec3 clouds = texture(environment_map, direction).rgb;
    vec3 radiance = neon_field(world) * 0.6 + clouds * (0.55 + 0.9 * strength * (0.5 + 0.5 * wave));
    radiance *= 1.0 - 0.2 * smoothstep(0.4, 1.4, length(screen_position));
    fragColor = vec4(radiance, 1.0);
    brightColor = vec4(0.0, 0.0, 0.0, 1.0);
}
#version 300 es
precision highp float;

out vec2 screen_position;

void main() {
    vec2 position = vec2(float((gl_VertexID << 1) & 2), float(gl_VertexID & 2));
    screen_position = position * 2.0 - 1.0;
    gl_Position = vec4(screen_position, 0.0, 1.0);
}
#version 300 es
precision highp float;

uniform float seconds;
uniform float fall_progress;
uniform samplerCube environment_map;
uniform float environment_strength;
uniform vec3 environment_center;
uniform float environment_extent;
in vec2 fragment_uv;
in vec3 world_position;
in vec3 surface_normal;
in float fragment_light;

// Balls cast soft shadows and bounce light by material: 0 diffuse, 1 metal, 2 dielectric.
uniform int ball_count;
uniform vec4 spheres[16];
uniform vec4 surfaces[16];

float ball_blocks(vec3 origin, vec3 direction, vec4 sphere) {
    vec3 offset = origin - sphere.xyz;
    float half_b = dot(offset, direction);
    float discriminant = half_b * half_b - dot(offset, offset) + sphere.w * sphere.w;
    return (discriminant >= 0.0 && half_b < 0.0) ? 1.0 : 0.0;
}

void ball_shading(vec3 point, vec3 normal, out vec3 shade, out vec3 glow) {
    shade = vec3(1.0);
    glow = vec3(0.0);
    for (int i = 0; i < 16; ++i) {
        if (i >= ball_count) break;
        vec4 sphere = spheres[i];
        // Shadow offset grows with the drop from the ball (light slope ~0.65 incl. softening) and
        // glow reaches 2.2 cells, so distant balls are skipped before any ray tests.
        vec2 flat_offset = sphere.xz - point.xz;
        float reach_limit = max(2.2, (sphere.y - point.y) * 0.65 + sphere.w + 0.1);
        if (dot(flat_offset, flat_offset) > reach_limit * reach_limit) continue;
        vec3 tint = surfaces[i].rgb;
        float kind = surfaces[i].a;
        vec3 origin = point + normal * 0.01;
        float blocked = 0.0;
        for (int s = 0; s < 4; ++s) {
            vec2 jitter = vec2((s & 1) == 0 ? -0.12 : 0.12, (s & 2) == 0 ? -0.12 : 0.12);
            blocked += ball_blocks(origin, normalize(vec3(-0.5 + jitter.x, 1.0, -0.35 + jitter.y)), sphere);
        }
        blocked *= 0.25;
        vec3 umbra = kind < 0.5 ? vec3(0.38) : (kind < 1.5 ? vec3(0.22) : mix(vec3(0.62), tint, 0.45));
        shade *= mix(vec3(1.0), umbra, blocked);
        vec3 to_ball = sphere.xyz - point;
        float distance_to_ball = length(to_ball);
        float reach = clamp(1.0 - distance_to_ball / 2.2, 0.0, 1.0);
        float facing = max(dot(normal, to_ball / max(distance_to_ball, 0.001)), 0.0);
        float bounce = kind < 0.5 ? 0.22 : (kind < 1.5 ? 0.12 : 0.34);
        glow += tint * reach * reach * facing * bounce;
    }
}

layout(location = 0) out vec4 accumulation;
layout(location = 1) out vec4 opticalDepth;

vec3 environment_direction(vec3 ray) {
    vec3 local = world_position - environment_center;
    vec3 safe_ray = mix(vec3(-1.0), vec3(1.0), step(vec3(0.0), ray)) * max(abs(ray), vec3(0.0001));
    vec3 distance_to_box = (sign(safe_ray) * environment_extent - local) / safe_ray;
    float travel = min(distance_to_box.x, min(distance_to_box.y, distance_to_box.z));
    return local + ray * travel;
}

void main() {
    vec2 local = abs(fract(world_position.xz + 0.5) - 0.5);
    float rim = smoothstep(0.40, 0.48, max(local.x, local.y));
    float depth = clamp((7.0 - world_position.y) * 0.5, 0.0, 2.0);
    float shimmer = 0.5 + 0.5 * sin(world_position.x * 2.0 + world_position.z * 1.3 + seconds * 0.6);
    float alpha = mix(0.10, 0.32, rim) + 0.03 * abs(surface_normal.x + surface_normal.z);
    vec3 color = mix(vec3(0.045, 0.20, 0.55), vec3(0.12, 0.58, 0.95), rim);
    color += vec3(0.95, 0.75, 0.15) * fragment_light;
    color *= (1.0 - depth * 0.14) * (0.92 + shimmer * 0.08);
    if (environment_strength > 0.0) {
        vec3 incident = vec3(0.0, -1.0, 0.0);
        vec3 normal = faceforward(normalize(surface_normal), incident, normalize(surface_normal));
        float fresnel = 0.04 + 0.96 * pow(1.0 - abs(dot(normal, -incident)), 5.0);
        vec3 reflected = texture(environment_map, environment_direction(reflect(incident, normal))).rgb;
        vec3 refracted = texture(environment_map, environment_direction(refract(incident, normal, 1.0 / 1.45))).rgb;
        color = mix(color, mix(refracted, reflected, fresnel), environment_strength);
    }
    vec3 ball_shade, ball_glow;
    ball_shading(world_position, vec3(0.0, 1.0, 0.0), ball_shade, ball_glow);
    float shadow_depth = 1.0 - min(ball_shade.r, min(ball_shade.g, ball_shade.b));
    color = color * ball_shade + ball_glow;
    alpha = min(alpha + shadow_depth * 0.2, 0.9);
    if (fragment_light > 4.5 && fragment_light < 5.5) {
        // Swarm bee: soft glowing dot (normal.x = tint, normal.y = swarm strength), shadowed like the board.
        float r2 = dot(fragment_uv, fragment_uv);
        if (r2 > 1.0) discard;
        float core = 1.0 - r2;
        vec3 bee = mix(vec3(1.0, 0.8, 0.15), vec3(1.0, 0.45, 0.1), surface_normal.x);
        color = bee * (0.8 + 0.5 * core * core) * ball_shade + ball_glow * 0.5;
        alpha = core * core * 0.28 * surface_normal.y;
    } else if (fragment_light > 2.5) {
        // Swipe trace: dominant color, feathered edge, shaded by the same balls as the board.
        bool ai_stroke = fragment_light > 5.5;
        bool active_stroke = fragment_light < 3.5 || (ai_stroke && fragment_light < 6.5);
        float feather = 1.0 - smoothstep(0.35, 1.0, abs(fragment_uv.x));
        float pulse = 0.88 + 0.12 * sin(seconds * 6.0);
        vec3 stroke = ai_stroke
            ? (active_stroke ? vec3(0.96, 0.94, 1.0) * pulse : vec3(0.74, 0.66, 0.92))
            : (active_stroke ? vec3(1.0, 0.86, 0.22) * pulse : vec3(0.95, 0.55, 0.16));
        color = stroke * ball_shade + ball_glow * 0.5;
        alpha = (active_stroke ? 0.9 : 0.65) * feather;
    } else if (fragment_light > 1.5) {
        color = vec3(0.95, 0.65, 0.22);
        alpha = 0.55 * (1.0 - fall_progress);
    }
    accumulation = vec4(color * alpha, alpha) / 8.0;
    opticalDepth = vec4(vec3(-log(1.0 - alpha) / 16.0), 0.0);
}
#version 300 es
precision highp float;

uniform sampler2D accumulation;
uniform sampler2D optical_depth;
in vec2 fragment_uv;
layout(location = 0) out vec4 fragColor;
layout(location = 1) out vec4 brightColor;

void main() {
    vec4 sum = texture(accumulation, fragment_uv);
    float opacity = 1.0 - exp(-texture(optical_depth, fragment_uv).r * 16.0);
    vec3 color = sum.rgb / max(sum.a, 0.0001);
    fragColor = vec4(color, opacity);
    brightColor = vec4(0.0, 0.0, 0.0, opacity);
}
#version 300 es
precision mediump float;

in vec3 our_color;

layout(location = 0) out vec4 frag_color;
layout(location = 1) out vec4 bright_color;

void main() {
    frag_color = vec4(1.0 - our_color, 1.0);

    float brightness = dot(frag_color.rgb, vec3(0.2126, 0.7152, 0.0722));
    if (brightness > 1.0) {
        bright_color = vec4(frag_color.rgb, 1.0);
    } else {
        bright_color = vec4(0.0, 0.0, 0.0, 1.0);
    }
}

#version 300 es
precision mediump float;

uniform mat4 matrix;

layout(location=0) in vec4 position;

out vec3 our_color;

void main() {
    our_color = vec3(0.0, 0.0, 1.0);
    gl_Position = matrix * position;
}
#version 300 es
precision highp float;

out vec4 FragColor;

uniform sampler2D sampler;
uniform float timer;

in vec2 fragment_uv;
in vec3 sky_direction;

const float pi = 3.14159265;

vec3 vertical_gradient(vec3 horizon, vec3 zenith, float height)
{
    return mix(horizon, zenith, smoothstep(0.28, 0.96, height));
}

void main()
{
    float day = smoothstep(0.24, 0.42, timer) * (1.0 - smoothstep(0.78, 0.96, timer));
    float dawn = exp(-pow((timer - 0.29) / 0.095, 2.0));
    float dusk = exp(-pow((timer - 0.86) / 0.095, 2.0));
    float twilight = clamp(max(dawn, dusk), 0.0, 1.0);
    float height = clamp(normalize(sky_direction).y * 0.5 + 0.5, 0.0, 1.0);

    vec3 night = vertical_gradient(vec3(0.035, 0.055, 0.12), vec3(0.012, 0.022, 0.075), height);
    vec3 daylight = vertical_gradient(vec3(0.68, 0.79, 0.91), vec3(0.16, 0.40, 0.78), height);
    vec3 sunset = vertical_gradient(vec3(1.0, 0.31, 0.13), vec3(0.23, 0.16, 0.42), height);
    vec3 sky = mix(night, daylight, day);
    sky = mix(sky, sunset, twilight * 0.92);

    vec3 texture_tint = texture(sampler, vec2(timer, fragment_uv.t)).rgb;
    sky = mix(sky, texture_tint, 0.12);

    float phase = 2.0 * pi * (timer - 0.6);
    vec3 sun_direction = normalize(vec3(sin(phase), cos(phase), -0.24));
    vec3 moon_direction = normalize(vec3(-sin(phase), -cos(phase), -0.24));
    vec3 view_direction = normalize(sky_direction);

    float sun_visibility = smoothstep(-0.08, 0.08, sun_direction.y);
    float sun_alignment = max(dot(view_direction, sun_direction), 0.0);
    float sun_halo = pow(sun_alignment, 42.0) + 0.22 * pow(sun_alignment, 9.0);
    float sun_disc = smoothstep(0.996, 0.999, sun_alignment);
    sky += vec3(1.0, 0.36, 0.12) * sun_halo * sun_visibility * (0.7 + twilight);
    sky = mix(sky, vec3(1.0, 0.91, 0.68), sun_disc * sun_visibility);

    float moon_visibility = smoothstep(-0.08, 0.08, moon_direction.y);
    float moon_alignment = max(dot(view_direction, moon_direction), 0.0);
    float moon_halo = 0.34 * pow(moon_alignment, 38.0) + 0.08 * pow(moon_alignment, 8.0);
    float moon_disc = smoothstep(0.997, 0.9994, moon_alignment);
    sky += vec3(0.30, 0.47, 0.95) * moon_halo * moon_visibility;
    sky = mix(sky, vec3(0.78, 0.86, 1.0), moon_disc * moon_visibility);

    FragColor = vec4(sky, 1.0);
}
